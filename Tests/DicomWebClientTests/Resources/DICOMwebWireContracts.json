    {
      "id": "qido-studies",
      "operation": "qidoStudies",
      "baseURL": "https://archive.example:443/dicom-web",
      "input": {
        "patientName": "DOE*",
        "limit": 25,
        "offset": 50
      },
      "sharedExpectation": {
        "method": "GET",
        "scheme": "https",
        "host": "archive.example",
        "port": 443,
        "path": "/dicom-web/studies",
        "query": {
          "PatientName": "DOE*",
          "limit": "25",
          "offset": "50"
        },
        "headers": {}
      },
      "dicomSwiftExpectation": {
        "query": {
          "includefield": "all"
        },
        "headers": {
          "Accept": "application/dicom+json"
        }
      },
      "isisExpectation": {
        "query": {
          "includefield": "StudyDescription,InstitutionName,PatientBirthDate,StudyTime,ModalitiesInStudy"
        },
        "headers": {
          "Accept": "application/dicom+json"
        }
      },
      "intentionalDifferences": [
        {
          "field": "query.includefield",
          "reason": "The toolkit compatibility client requests all fields; Isis requests only fields consumed by its study mapper."
        }
      ]
    },
